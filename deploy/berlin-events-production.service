[Unit]
Description=Berlin Events Explorer Production Web Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/berlin-events-explorer/releases/current
Environment=PATH=/home/oskar-maria/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/oskar-maria/.local/bin/uv run --no-sync --directory %h/.local/share/berlin-events-explorer/releases/current berlin-events web --database /home/oskar-maria/projects/dev/berlin-events-explorer/events.sqlite --host 127.0.0.1 --port 8000 --sync-interval-minutes 0
Restart=always
RestartSec=5
RestartPreventExitStatus=100
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
